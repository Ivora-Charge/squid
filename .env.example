# Only server-side environment variables are required. Never prefix secret keys with NEXT_PUBLIC_.
# Match the URL you open, including the port. For phone testing, use your computer's LAN IP.
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Vercel Preview only: trusted host suffix for preview aliases, such as .squidcharge.dev.
PREVIEW_HOST_SUFFIX=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Optional; used only by npm run db:migrate. Use Supabase's direct/session pooler URL.
SUPABASE_DB_URL=
# Optional custom sign-in emails. Without Resend, Supabase handles email delivery.
RESEND_API_KEY=
RESEND_FROM_EMAIL="Squid by Ivora <hello@squidcharge.io>"
IVORA_API_URL=https://api.ivoracharge.co
IVORA_API_KEY=
IVORA_TENANT_ID=
# Optional server-only OCPP WebSocket prefix; the station identity is appended.
OCPP_URL_PREFIX=
# Server-only key with Google Places API (New) and Time Zone API enabled.
GOOGLE_MAPS_ADDRESS_API_KEY=
# Generate once with: openssl rand -hex 32. Keep this key to decrypt saved charger passwords.
OCPP_CREDENTIAL_KEY=
# Squid owns payments. Enable Stripe Connect in your Stripe platform account.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CONNECT_WEBHOOK_SECRET=
CRON_SECRET=
# Optional analytics. Both are public by design and load in the browser only when set.
# The Vercel PostHog integration provisions the PostHog pair.
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
# Google Analytics 4 measurement ID, such as G-XXXXXXXXXX.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
